# Copy to config.env and adjust. config.env is git-ignored.

# ---- general ----------------------------------------------------------------
#WORKDIR=$HOME/clickhouse-demo     # where binaries, data and logs go
#KEEP_BINARY=0                     # 1 = keep the ClickHouse binary on re-runs (no 2nd download)
#DEMO_AUTO=0                       # 1 = never pause (same as -y)
#AUTO_DELAY=0                      # seconds between steps in auto mode
#PKG_MGR=                          # force dnf | yum | apt (default: auto-detect, Oracle Linux -> dnf)

# ---- ports (change them if 8123/9000/5433 are taken) -----------------------------
#CH_HTTP_PORT=8123
#CH_TCP_PORT=9000
#PG_PORT=5433

# ---- data volume ------------------------------------------------------------
#ROWS_CH=2000000                   # demo 1: rows generated inside ClickHouse
#ROWS_PG=1000000                   # demo 2 + 3: rows seeded into PostgreSQL

# ---- demo 3: Aiven ----------------------------------------------------------
#AIVEN_PROJECT=my-project          # REQUIRED for demo 3 (name of your Aiven project)
#AIVEN_AUTH_TOKEN=                 # optional: token instead of `avn user login`
#AIVEN_CLOUD=google-europe-west1   # see: avn cloud list
#AIVEN_PG_NAME=shop-pg
#AIVEN_CH_NAME=beer-clickhouse
#AIVEN_KAFKA_NAME=events-kafka
#AIVEN_PG_PLAN=startup-4
#AIVEN_CH_PLAN=startup-16
#AIVEN_KAFKA_PLAN=startup-2
#WITH_KAFKA=0                      # 1 = also demo the Kafka integration
#MODE=cli                          # cli (avn) | terraform (terraform/ directory)

# ---- clickhouse-client noise (mostly relevant for demo 3 against Aiven) -------
#CH_FILTER_NOISE=1                 # 1 = drop the harmless "Unknown settings: ..., skipping" line (default); 0 = show it
#CH_CLIENT_NO_WARNINGS=0           # 1 = pass --no-warnings (hides server warnings printed on connect)
